6H│\u001b[9;86H│\u001b[10;86H│\u001b[11;86H│\u001b[12;86H│\u001b[13;86H│\u001b[14;86H│\u001b[15;86H│\u001b[16;86H│\u001b[17;86H│\u001b[18;86H│\u001b[19;86H│\u001b[20;86H│\u001b[21;86H│\u001b[22;86H│\u001b[23;86H│\u001b[24;86H│\u001b[25;86H│\r\n\u001b[38;5;238m──\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[22;89H\u001b[?25l\u001b[H\u001b[38;5;238m──\u001b[83C\u001b[38;5;39m┬──\u001b[2;86H│\u001b[3;86H│\u001b[4;86H│\u001b[5;86H│\u001b[6;86H│\u001b[7;86H│\u001b[8;86H│\u001b[9;86H│\u001b[10;86H│\u001b[11;86H│\u001b[12;86H│\u001b[13;86H│\u001b[14;86H│\u001b[15;86H│\u001b[16;86H│\u001b[17;86H│\u001b[18;86H│\u001b[19;86H│\u001b[20;86H│\u001b[21;86H│\u001b[22;86H│\u001b[23;86H│\u001b[24;86H│\u001b[25;86H│\r\n\u001b[38;5;238m──\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[22;89H\u001b[?25l\u001b[H\u001b[38;5;238m──\u001b[83C\u001b[38;5;39m┬──\u001b[2;86H│\u001b[3;86H│\u001b[4;86H│\u001b[5;86H│\u001b[6;86H│\u001b[7;86H│\u001b[8;86H│\u001b[9;86H│\u001b[10;86H│\u001b[11;86H│\u001b[12;86H│\u001b[13;86H│\u001b[14;86H│\u001b[15;86H│\u001b[16;86H│\u001b[17;86H│\u001b[18;86H│\u001b[19;86H│\u001b[20;86H│\u001b[21;86H│\u001b[22;86H│\u001b[23;86H│\u001b[24;86H│\u001b[25;86H│\r\n\u001b[38;5;238m──\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[22;89H\u001b[?25l\u001b[H\u001b[38;5;238m──\u001b[83C\u001b[38;5;39m┬──\u001b[2;86H│\u001b[3;86H│\u001b[4;86H│\u001b[5;86H│\u001b[6;86H│\u001b[7;86H│\u001b[8;86H│\u001b[9;86H│\u001b[10;86H│\u001b[11;86H│\u001b[12;86H│\u001b[13;86H│\u001b[14;86H│\u001b[15;86H│\u001b[16;86H│\u001b[17;86H│\u001b[18;86H│\u001b[19;86H│\u001b[20;86H│\u001b[21;86H│\u001b[22;86H│\u001b[23;86H│\u001b[24;86H│\u001b[25;86H│\r\n\u001b[38;5;238m──\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[22;89H\u001b[?25l\u001b[2m\u001b[19;87H◦\u001b(B\u001b[m \u001b[2mWorking\u001b(B\u001b[m \u001b[2m(0s • \u001b(B\u001b[m\u001b[1mesc\u001b(B\u001b[m\u001b[2m to interrupt)\u001b(B\u001b[m\u001b[K\u001b[22;89H\u001b[?12l\u001b[?25h\u001b[?25l\u001b[H\u001b[38;5;238m──\u001b[83C\u001b[38;5;39m┬─